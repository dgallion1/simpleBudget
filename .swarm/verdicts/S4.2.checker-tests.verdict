$ go test -count=1 -run 'TestCHK_RegionAndDataNodeAgree' -v ./internal/handlers/accounts/
  zz_checker_test.go:208: CHK region="Pattern overlap warning: file
    \"usaa-checking.csv\" matches multiple accounts (a-wide, b-narrow);
    \"a-wide\" wins by ID order"
  zz_checker_test.go:209: CHK data  ="Pattern overlap warning: file
